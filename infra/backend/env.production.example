APP_ENV=production
APP_NAME=kaziro
LOG_LEVEL=INFO
LOG_FORMAT=json
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_HOST_PORT=8001
CORS_ORIGINS=https://your-kaziro-frontend.vercel.app

DATABASE_URL=postgresql+asyncpg://user:password@db.example.supabase.co:5432/postgres
DATABASE_URL_SYNC=postgresql://user:password@db.example.supabase.co:5432/postgres

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=replace-with-jwt-secret
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_JOB_POSTS_BUCKET=job_posts

REDIS_URL=redis://redis:6379/0
REDIS_CACHE_DB=0
REDIS_BROKER_DB=1
REDIS_RESULT_DB=2
REDIS_PUBSUB_DB=3

OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_APP_URL=https://your-kaziro-frontend.vercel.app
OPENROUTER_APP_TITLE=Kaziro

RAPIDAPI_KEY=replace-with-rapidapi-key
RAPIDAPI_HOST=jsearch.p.rapidapi.com
FIRECRAWL_API_KEY=replace-with-firecrawl-key

LANGSMITH_TRACING=false
