# =============================================================================
# Kaziro — Example environment file
# =============================================================================
# Copy to `.env` and fill in real values. Real `.env` files are git-ignored —
# never commit one. The canonical reference for every variable below lives
# in `docs/reference/env-vars.md`.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development                       # development | staging | production | test
APP_NAME=kaziro
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console                        # console (dev) | json (prod)
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Database (Supabase / Postgres)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://kaziro:kaziro@localhost:5432/kaziro
DATABASE_URL_SYNC=postgresql://kaziro:kaziro@localhost:5432/kaziro
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=changeme-anon-key
SUPABASE_SERVICE_KEY=changeme-service-key      # Backend only — bypasses RLS.
SUPABASE_JWT_SECRET=changeme-jwt-secret
SUPABASE_STORAGE_BUCKET=documents

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=0
REDIS_BROKER_DB=1
REDIS_RESULT_DB=2
REDIS_PUBSUB_DB=3

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
# CELERY_BROKER_URL is derived from REDIS_URL + REDIS_BROKER_DB by default.
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false             # true only for tests
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

# -----------------------------------------------------------------------------
# OpenAI / LLM
# -----------------------------------------------------------------------------
OPENAI_API_KEY=changeme-openai-key
# OPENAI_ORG_ID=
# OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
LLM_MODEL_PARSER=gpt-4o-mini
LLM_MODEL_EVALUATOR=gpt-4o
LLM_MODEL_RESEARCH=gpt-4o
LLM_MODEL_DOCUMENT=gpt-4o
LLM_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# External integrations
# -----------------------------------------------------------------------------
RAPIDAPI_KEY=changeme-rapidapi-key
RAPIDAPI_HOST=jsearch.p.rapidapi.com
FIRECRAWL_API_KEY=changeme-firecrawl-key
# FIRECRAWL_BASE_URL=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=kaziro-backend
OTEL_SAMPLE_RATE=0.1
PROMETHEUS_METRICS_PATH=/metrics
# SENTRY_DSN=
# SENTRY_ENV=development
SENTRY_TRACES_SAMPLE_RATE=0.05

# -----------------------------------------------------------------------------
# Frontend (PUBLIC_* values are exposed to the browser)
# -----------------------------------------------------------------------------
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_WS_URL=ws://localhost:8000/ws
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=changeme-anon-key
# PUBLIC_SENTRY_DSN=
PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Local-dev only
# -----------------------------------------------------------------------------
RELOAD=true
MOCK_LLM=false
MOCK_FIRECRAWL=false
