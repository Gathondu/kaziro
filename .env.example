# =============================================================================
# Kaziro — Example environment file
# =============================================================================
# Copy to `.env` and fill in real values. Real `.env` files are git-ignored —
# never commit one. The canonical reference for every variable below lives
# in `docs/reference/env-vars.md`.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development                       # development | staging | production | test
APP_NAME=kaziro
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console                        # console (dev) | json (prod)
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Database (Supabase / Postgres)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://kaziro:kaziro@localhost:5432/kaziro
DATABASE_URL_SYNC=postgresql://kaziro:kaziro@localhost:5432/kaziro
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=changeme-anon-key
SUPABASE_SERVICE_KEY=changeme-service-key      # Backend only — bypasses RLS.
SUPABASE_JWT_SECRET=changeme-jwt-secret
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_JOB_POSTS_BUCKET=job_posts

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=0
REDIS_BROKER_DB=1
REDIS_RESULT_DB=2
REDIS_PUBSUB_DB=3
# Optional external WebSocket management path. Leave unset for the active
# server-hosted deployment, which uses FastAPI WebSockets plus Redis pub/sub.
# WS_CONNECTIONS_TABLE=
# WS_MANAGEMENT_API_ENDPOINT=

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
# CELERY_BROKER_URL is derived from REDIS_URL + REDIS_BROKER_DB by default.
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false             # true only for tests
CELERY_WORKER_CONCURRENCY=4
# CELERY_WORKER_POOL=prefork               # prefork | solo | threads | … Unset = solo on Windows, prefork on Unix.
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

# -----------------------------------------------------------------------------
# OpenRouter / LLM
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=changeme-openrouter-key
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_APP_URL=https://your-app.example
# OPENROUTER_APP_TITLE=Kaziro
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=3
LLM_MODEL_PARSER=nvidia/nemotron-3-super-120b-a12b:free
LLM_MODEL_EVALUATOR=nvidia/nemotron-3-super-120b-a12b:free
LLM_MODEL_RESEARCH=nvidia/nemotron-3-super-120b-a12b:free
LLM_MODEL_DOCUMENT=nvidia/nemotron-3-super-120b-a12b:free
LLM_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
LLM_EMBEDDING_DIM=2048

# -----------------------------------------------------------------------------
# External integrations
# -----------------------------------------------------------------------------
RAPIDAPI_KEY=changeme-rapidapi-key
# JSearch (RapidAPI) — must match your subscribed provider host.
RAPIDAPI_HOST=jsearch.p.rapidapi.com
# RAPIDAPI_JOB_FETCH_LIMIT=100
# RAPIDAPI_FETCH_MAX_ATTEMPTS=6
# RAPIDAPI_FETCH_RETRY_AFTER_CAP_S=120
FIRECRAWL_API_KEY=changeme-firecrawl-key
# FIRECRAWL_BASE_URL=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=kaziro-backend
OTEL_SAMPLE_RATE=0.1
PROMETHEUS_METRICS_PATH=/metrics
# SENTRY_DSN=
# SENTRY_ENV=development
SENTRY_TRACES_SAMPLE_RATE=0.05


# -----------------------------------------------------------------------------
# Local-dev only
# -----------------------------------------------------------------------------
RELOAD=true
MOCK_LLM=false
MOCK_FIRECRAWL=false


# -----------------------------------------------------------------------------
# LangSmith tracing
# -----------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_PROJECT=kaziro
