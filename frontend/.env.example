# Frontend environment variables. Copy to `.env` (or `.env.local`) for local
# dev. Vite exposes only vars prefixed with `PUBLIC_` to the browser bundle —
# everything else is server-only.

# --- Public (shipped to the browser) ---------------------------------------
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=changeme-anon-key
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_WS_URL=ws://localhost:8000/ws

# --- Server-only (used in load functions / server actions) -----------------
SUPABASE_SERVICE_KEY=changeme-service-role-key
