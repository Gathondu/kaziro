# Browser (SvelteKit `PUBLIC_*` — read via `$env/dynamic/public` in `src/lib/env/public.ts`)
# Copy to `.env` for local dev. CI / `pnpm build` use safe placeholders when unset.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Kaziro FastAPI (same origin in production or http://localhost:8000 in dev)
PUBLIC_API_URL=http://localhost:8000
