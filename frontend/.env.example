# Browser (SvelteKit `PUBLIC_*` — read via `$env/dynamic/public` in `src/lib/env/public.ts`)
# Copy to `.env` for local dev. CI / `pnpm build` use safe placeholders when unset.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Kaziro FastAPI origin only (no /api/v1 suffix). Use http://localhost:8000 in dev.
PUBLIC_API_URL=http://localhost:8000
# Optional — canonical site URL for SEO (canonical, Open Graph) on the static marketing page.
# When unset, the app skips canonical/og:url tags instead of guessing the public origin.
# PUBLIC_SITE_URL=https://app.kaziro.example
# Optional websocket origin override (e.g. App Runner URL in AWS deploys)
# PUBLIC_WS_URL=http://localhost:8000
# Optional — shown where users are told how to request full data deletion
# PUBLIC_SUPPORT_EMAIL=privacy@yourcompany.com
