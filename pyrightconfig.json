{
  "$schema": "https://raw.githubusercontent.com/microsoft/pyright/main/packages/vscode-pyright/schemas/pyrightconfig.schema.json",
  "include": ["backend"],
  "exclude": [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.mypy_cache",
    "**/migrations",
    "frontend",
    "docs",
    "infra"
  ],
  "venvPath": "backend",
  "venv": ".venv314",
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": ["backend"]
    }
  ],
  "pythonVersion": "3.14",
  "typeCheckingMode": "basic"
}
